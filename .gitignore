# ---- 虚拟环境（重建：python -m venv fake_news_env && pip install -r requirements.txt）----
fake_news_env/
.venv/
__pycache__/
*.pyc

# ---- 凭据与账号（绝不入库）----
accounts.sqlite
accounts.sqlite-*
accounts.txt
.env
*.key
secrets/

# ---- 媒体与大文件（版权 + 体积：仅本地保留，索引在 metadata/）----
media/

# ---- 案例制数据集：文本类入库（正文/字幕/理由/来源/索引），媒体本体不入库 ----
dataset/**/*.mp4
dataset/**/*.mp3
dataset/**/*.m4a
dataset/**/*.wav
dataset/**/*.png
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.webp
dataset/**/*.gif
dataset/**/*.mkv
dataset/**/*.webm

# ---- 运行产物 ----
logs/

# ---- 系统文件 ----
Thumbs.db
.DS_Store
