# ---- 虚拟环境（重建：python -m venv fake_news_env && pip install -r requirements.txt）----
fake_news_env/
.venv/
__pycache__/
*.pyc

# ---- 凭据与账号（绝不入库）----
accounts.sqlite
accounts.sqlite-*
accounts*.txt
.env
*.key
secrets/

# ---- 运行产物 ----
logs/

# ---- 系统文件 ----
Thumbs.db
.DS_Store

# ============================================================
# 媒体入库政策（2026-10-26 起生效，替代旧的"媒体不入库"设计）
#
# 本项目沉淀的核心成果就是多模态案例本体（图片/视频/音频），
# 媒体与文本同等入库，GitHub 单文件上限 100MB，当前最大 29.5MB 视频可直接放。
# 新增大文件前自查：>50MB GitHub 会警告，>100MB 必须改走 Git LFS 或裁剪。
# ============================================================
